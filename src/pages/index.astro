---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const sections = (await getCollection('sections')).sort(
  (a, b) => a.data.order - b.data.order
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="詹詠文 · 個人網站">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-gradient-to-br from-paper-soft via-paper to-paper"></div>
      <div class="absolute right-0 top-0 h-96 w-96 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="absolute left-1/3 bottom-0 h-72 w-72 rounded-full bg-highlight/20 blur-3xl"></div>
    </div>

    <div class="mx-auto max-w-content px-8 pt-28 pb-20 lg:px-16 lg:pt-32 lg:pb-28">
      <p class="font-display text-xs font-bold uppercase tracking-[0.4em] text-accent">
        Jan Yung Wen · Portfolio
      </p>
      <h1 class="mt-6 font-display text-6xl font-black leading-none tracking-tight text-ink lg:text-8xl">
        詹詠文
      </h1>
      <p class="mt-8 max-w-2xl font-display text-xl font-medium leading-relaxed text-ink-soft lg:text-2xl">
        資訊暨資安主管 · 用穩健的系統架構與資安治理，守護企業的核心運行。
      </p>
      <p class="mt-4 max-w-2xl text-base text-ink-muted">
        8+ 年系統開發與維運經驗 · 現任合作金庫創業投資資訊主管 · JLPT N2 · CCNA
      </p>
      <div class="mt-12 flex flex-wrap gap-4">
        <a
          href={`${base}/about`}
          class="group inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 font-display text-sm font-bold text-paper transition-all hover:bg-accent"
        >
          認識我
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a
          href={`${base}/projects`}
          class="inline-flex items-center gap-2 rounded-full border border-ink/20 px-6 py-3 font-display text-sm font-bold text-ink transition-all hover:border-ink hover:bg-ink hover:text-paper"
        >
          看作品
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-content px-8 py-16 lg:px-16">
    <div class="mb-12 flex items-end justify-between border-b border-ink/10 pb-6">
      <div>
        <p class="font-display text-xs font-bold uppercase tracking-[0.4em] text-accent">Contents</p>
        <h2 class="mt-3 font-display text-4xl font-black text-ink">瀏覽</h2>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        sections.map((section) => (
          <a
            href={`${base}/${section.slug}`}
            class="group relative overflow-hidden rounded-2xl border border-ink/10 bg-paper-soft p-8 transition-all hover:-translate-y-1 hover:border-accent hover:shadow-lg"
          >
            <div class="absolute left-0 top-0 h-full w-1 bg-transparent transition-colors group-hover:bg-accent"></div>
            <p class="text-4xl">{section.data.icon ?? '•'}</p>
            <h3 class="mt-6 font-display text-2xl font-black text-ink">{section.data.title}</h3>
            {section.data.description && (
              <p class="mt-2 text-sm text-ink-soft">{section.data.description}</p>
            )}
            <p class="mt-8 font-display text-xs font-bold uppercase tracking-[0.3em] text-ink-muted transition-colors group-hover:text-accent">
              查看 →
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
