---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const sections = (await getCollection('sections')).sort(
  (a, b) => a.data.order - b.data.order
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stats = [
  { label: 'years experience', value: '8+', hint: 'software · infra · security' },
  { label: 'certifications', value: '6', hint: '4 earned · 2 in progress' },
  { label: 'iso standards delivered', value: '4', hint: '14064 / 50001 / 14001 / 20400' },
  { label: 'languages', value: '3', hint: 'zh · ja (n2) · en' },
];
---

<Layout title="Jan Yung Wen — IT & Information Security Lead">
  <section class="relative overflow-hidden border-b border-ink/10">
    <div class="absolute inset-0 -z-10 bg-dot-grid opacity-60"></div>
    <div class="absolute right-0 top-0 -z-10 h-[32rem] w-[32rem] rounded-full bg-tech/5 blur-3xl"></div>
    <div class="absolute left-1/3 bottom-0 -z-10 h-72 w-72 rounded-full bg-accent/10 blur-3xl"></div>

    <div class="mx-auto max-w-content px-8 pt-28 pb-10 lg:px-16 lg:pt-32">
      <div class="mb-6 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-tech">
        <span class="dot-live animate-pulse"></span>
        <span>portfolio</span>
        <span class="text-ink-muted">//</span>
        <span class="text-ink-muted">updated {new Date().toISOString().split('T')[0]}</span>
      </div>

      <h1 class="font-display text-5xl font-black leading-[0.95] tracking-tight text-ink lg:text-7xl">
        Jan Yung Wen
        <span class="block font-mono text-xl font-normal text-ink-muted lg:text-2xl">詹詠文</span>
      </h1>

      <p class="mt-8 font-display text-2xl font-bold text-accent lg:text-3xl">
        IT & Information Security Lead
      </p>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft lg:text-xl">
        I build and defend the systems that keep businesses running. 8+ years
        across software engineering, infrastructure, and ISO-aligned security
        governance — currently leading IT and information security at a
        Taipei-based venture capital firm.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={`${base}/summary`}
          class="group inline-flex items-center gap-2 rounded-md bg-ink px-5 py-3 font-mono text-sm font-medium text-paper transition-all hover:bg-tech"
        >
          View Summary
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a
          href="mailto:overfly0708@gmail.com"
          class="inline-flex items-center gap-2 rounded-md border border-ink/20 bg-paper px-5 py-3 font-mono text-sm font-medium text-ink transition-all hover:border-tech hover:text-tech"
        >
          <span>email ↗</span>
        </a>
        <a
          href="https://github.com/andywen78"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-ink/20 bg-paper px-5 py-3 font-mono text-sm font-medium text-ink transition-all hover:border-tech hover:text-tech"
        >
          <span>github ↗</span>
        </a>
      </div>
    </div>

    <div class="mx-auto max-w-content px-8 pb-16 lg:px-16">
      <div class="mt-12 grid grid-cols-2 gap-0 rounded-lg border border-ink/10 bg-paper/70 backdrop-blur lg:grid-cols-4">
        {
          stats.map((stat, i) => (
            <div
              class:list={[
                'relative p-6 lg:p-7',
                i > 0 && 'border-t border-ink/10 lg:border-t-0 lg:border-l',
                i === 1 && 'border-l border-ink/10 lg:border-l',
              ]}
            >
              <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-muted">
                {stat.label}
              </p>
              <p class="mt-3 font-display text-4xl font-black text-ink lg:text-5xl">
                {stat.value}
              </p>
              <p class="mt-2 font-mono text-[11px] text-ink-muted">{stat.hint}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-content px-8 py-20 lg:px-16">
    <div class="mb-12 flex items-end justify-between border-b border-ink/10 pb-6">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.25em] text-tech">
          # contents
        </p>
        <h2 class="mt-3 font-display text-4xl font-black text-ink">Sections</h2>
      </div>
      <p class="hidden font-mono text-xs text-ink-muted lg:block">
        {sections.length + 1} files · keyboard-first navigation
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sections.map((section) => (
          <a
            href={`${base}/${section.slug}`}
            class="group relative overflow-hidden rounded-lg border border-ink/10 bg-paper p-6 transition-all hover:-translate-y-1 hover:border-tech hover:shadow-lg"
          >
            <div class="absolute left-0 top-0 h-full w-[3px] bg-transparent transition-colors group-hover:bg-tech"></div>
            <div class="flex items-center justify-between">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-tech/10 text-tech transition-colors group-hover:bg-tech group-hover:text-paper">
                <Icon name={section.data.icon} class="h-6 w-6" />
              </div>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-muted">
                /{section.slug}
              </span>
            </div>
            <h3 class="mt-6 font-display text-xl font-black text-ink">
              {section.data.title}
            </h3>
            {section.data.description && (
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                {section.data.description}
              </p>
            )}
            <p class="mt-6 font-mono text-[11px] text-ink-muted transition-colors group-hover:text-tech">
              read more →
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
