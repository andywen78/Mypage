---
import { getCollection } from 'astro:content';

const sections = (await getCollection('sections')).sort(
  (a, b) => a.data.order - b.data.order
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<button
  id="sidebar-toggle"
  class="fixed top-4 left-4 z-50 rounded-lg bg-ink p-3 text-paper shadow-lg lg:hidden"
  aria-label="Toggle navigation"
>
  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
  </svg>
</button>

<div id="sidebar-overlay" class="fixed inset-0 z-30 hidden bg-ink/50 lg:hidden"></div>

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 w-72 -translate-x-full transform overflow-y-auto border-r border-ink/10 bg-paper-soft px-7 py-10 transition-transform duration-200 lg:translate-x-0"
>
  <a href={`${base}/`} class="mb-10 block">
    <div class="mb-2 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.3em] text-tech">
      <span class="dot-live animate-pulse"></span>
      <span>available · 2026</span>
    </div>
    <p class="font-display text-3xl font-black leading-tight tracking-tight text-ink">
      Jan Yung Wen
    </p>
    <p class="font-mono text-[11px] text-ink-muted">詹詠文</p>
    <p class="mt-3 font-display text-[11px] font-bold uppercase tracking-[0.2em] text-accent">
      IT & InfoSec Lead
    </p>
  </a>

  <nav>
    <p class="mb-3 font-mono text-[10px] uppercase tracking-[0.25em] text-ink-muted">
      <span class="text-tech">$</span> ls ./sections
    </p>
    <ul class="space-y-0.5">
      <li>
        <a
          href={`${base}/`}
          class:list={[
            'group flex items-center gap-3 rounded-md px-3 py-2 font-mono text-[13px] transition-colors',
            currentPath === base || currentPath === ''
              ? 'bg-ink text-paper'
              : 'text-ink-soft hover:bg-ink/5 hover:text-ink',
          ]}
        >
          <span class="text-tech/80">▸</span>
          <span>index.md</span>
        </a>
      </li>
      {
        sections.map((section) => {
          const href = `${base}/${section.slug}`;
          const active = currentPath === href;
          return (
            <li>
              <a
                href={href}
                class:list={[
                  'group flex items-center gap-3 rounded-md px-3 py-2 font-mono text-[13px] transition-colors',
                  active
                    ? 'bg-ink text-paper'
                    : 'text-ink-soft hover:bg-ink/5 hover:text-ink',
                ]}
              >
                <span class="text-tech/80">▸</span>
                <span>{section.slug}.md</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="mt-10 border-t border-ink/10 pt-6">
    <p class="mb-3 font-mono text-[10px] uppercase tracking-[0.25em] text-ink-muted">
      <span class="text-tech">$</span> cat ./contact
    </p>
    <div class="flex flex-col gap-1.5 font-mono text-[12px] text-ink-soft">
      <a href="mailto:overfly0708@gmail.com" class="hover:text-tech">
        <span class="text-ink-muted">email </span>→ overfly0708@gmail.com
      </a>
      <a href="https://github.com/andywen78" class="hover:text-tech" target="_blank" rel="noreferrer">
        <span class="text-ink-muted">gh    </span>→ @andywen78
      </a>
      <p class="text-ink-muted">
        <span class="text-ink-muted">loc   </span>→ Taipei, TW
      </p>
    </div>
  </div>

  <div class="mt-8 rounded-md border border-ink/10 bg-paper p-3 font-mono text-[11px] text-ink-muted">
    <p class="text-tech">{'// status'}</p>
    <p class="mt-1">
      <span class="dot-live"></span> open to roles
    </p>
    <p class="mt-0.5">
      <span class="dot-live"></span> us · jp · apac
    </p>
  </div>
</aside>
