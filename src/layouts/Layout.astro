---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

// 站台網域 — 換自訂網域後改這一行 + astro.config.mjs 的 site/base
const SITE_ORIGIN = 'https://andywen78.github.io';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title,
  description = 'IT & Information Security Lead with 8+ years across software engineering, infrastructure, and ISO-aligned security governance. Open to roles in Taiwan, Japan, and APAC.',
  image = `${SITE_ORIGIN}${BASE}/og.png`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_ORIGIN).href;

// LinkedIn — 填入你的 LinkedIn 連結後,sameAs 與聯絡頁會一起顯示
const LINKEDIN = 'https://www.linkedin.com/in/andywen78';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yung-wen Jan',
  alternateName: '詹詠文',
  jobTitle: 'IT & Information Security Lead',
  url: `${SITE_ORIGIN}${BASE}/`,
  email: 'overfly0708@gmail.com',
  worksFor: { '@type': 'Organization', name: 'Taiwan Cooperative Venture Capital' },
  address: { '@type': 'PostalAddress', addressLocality: 'Taipei', addressCountry: 'TW' },
  knowsLanguage: ['zh-TW', 'ja', 'en'],
  sameAs: ['https://github.com/andywen78', LINKEDIN],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Yung-wen Jan" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph (LinkedIn / Facebook / Slack 分享預覽卡) -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Yung-wen Jan — Portfolio" />
    <meta property="profile:first_name" content="Yung-wen" />
    <meta property="profile:last_name" content="Jan" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- 結構化資料:讓 Google 認得這是一個人物檔案 -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-paper text-ink font-body antialiased">
    <div class="relative flex min-h-screen">
      <Sidebar />
      <main class="flex-1 lg:ml-72">
        <slot />
        <footer class="mt-24 border-t border-ink/10 px-8 py-10 lg:px-16">
          <div class="flex flex-col items-start justify-between gap-4 text-xs lg:flex-row lg:items-center">
            <p class="font-mono text-ink-muted">
              <span class="text-tech">//</span> © {new Date().getFullYear()} Yung-wen Jan · Built with Astro + Tailwind
            </p>
            <p class="font-mono text-ink-muted">
              <span class="mr-1 inline-block h-2 w-2 animate-pulse rounded-full bg-status-live align-middle"></span>
              system online
            </p>
          </div>
        </footer>
      </main>
    </div>

    <script>
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      const close = () => {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
      };
      toggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('-translate-x-full');
        overlay?.classList.toggle('hidden');
      });
      overlay?.addEventListener('click', close);
    </script>
  </body>
</html>
